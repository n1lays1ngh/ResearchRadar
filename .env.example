# Copy to .env and fill in. Empty values are treated as "not set".

# --- LLM (any OpenAI-compatible endpoint; default = Gemini free tier) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Check the exact ID with: python llm.py --list-models
LLM_MODEL=gemini-3.1-flash-lite
LLM_DELAY_SECONDS=6

# --- Optional fallback provider (leave empty to disable) ---
# Groq:    https://api.groq.com/openai/v1   model e.g. llama-3.1-8b-instant
# Mistral: https://api.mistral.ai/v1        model e.g. mistral-small-latest
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Tavily web search (optional) ---
TAVILY_API_KEY=
TAVILY_MAX_CALLS_PER_RUN=25

# --- Email (Gmail: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com

# --- Digest / chat tuning ---
DAYS_BACK=7
DIGEST_CONTEXT_CHARS=9000
CHAT_CONTEXT_CHARS=14000
# Public URL of the website (Vercel), e.g. https://rinfo.vercel.app
SITE_URL=

# --- Newsletter subscribers (optional; see README "Subscriptions") ---
# Key that encrypts the subscriber list: python subscribers.py --new-key
SUBSCRIBERS_KEY=
# Fine-grained GitHub token, this repo only, "Contents: Read and write"
GH_TOKEN=
# owner/repo, e.g. n1lays1ngh/ResearchRadar (GitHub Actions sets this automatically)
GITHUB_REPO=

# --- Daily brief (run_brief.py) ---
# Papers per section in the Monday-to-Friday brief
DAILY_PER_SECTION=5
